SUPABASE_URL=supabase_url
SUPABASE_KEY=supabase_anon_key

# Question pipeline: which LLM generates and checks questions (only .env changes to switch)
# Groq (or any OpenAI-compatible API: DeepSeek, Together, OpenAI)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# gpt-oss 'thinks' before answering: give it room and ask it to think less
LLM_MAX_TOKENS=6000
LLM_REASONING_EFFORT=low
LLM_API_KEY=
#
# Ollama instead (local: http://localhost:11434 with no key; cloud: https://ollama.com, needs paid credits)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=https://ollama.com
# LLM_MODEL=gpt-oss:20b
# LLM_API_KEY=

# Admin routes (temporary, until the database has an admin role): comma-separated emails
ADMIN_EMAILS=

# Server only: lets the backend check admins and publish questions. Never put it in the app.
SUPABASE_SERVICE_KEY=
